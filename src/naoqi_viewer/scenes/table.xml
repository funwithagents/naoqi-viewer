<!-- The "table" scene: the empty scene plus a low table with a few objects in front of the robot,
     so the head cameras have something to see. The robot is attached by model.load_world. -->
<mujoco model="table">
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.55 0.65 0.75" rgb2="0.15 0.18 0.22"
             width="512" height="512"/>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.62 0.64 0.66" rgb2="0.5 0.52 0.54"
             width="512" height="512" mark="edge" markrgb="0.45 0.47 0.49"/>
    <material name="floor" texture="checker" texrepeat="8 8" texuniform="true" reflectance="0.1"/>
    <material name="wood" rgba="0.62 0.45 0.3 1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <!-- A table 25 cm high, from 30 to 70 cm in front of the robot: close enough for the bottom
         camera, far enough for the top camera, which looks almost level, to see over its edge. -->
    <body name="table" pos="0.5 0 0">
      <geom name="table_top" type="box" pos="0 0 0.24" size="0.2 0.3 0.01" material="wood"/>
      <geom name="table_leg_fl" type="box" pos="0.17 0.27 0.115" size="0.015 0.015 0.115" material="wood"/>
      <geom name="table_leg_fr" type="box" pos="0.17 -0.27 0.115" size="0.015 0.015 0.115" material="wood"/>
      <geom name="table_leg_rl" type="box" pos="-0.17 0.27 0.115" size="0.015 0.015 0.115" material="wood"/>
      <geom name="table_leg_rr" type="box" pos="-0.17 -0.27 0.115" size="0.015 0.015 0.115" material="wood"/>
    </body>

    <body name="red_ball" pos="0.47 0.07 0.28">
      <geom name="red_ball" type="sphere" size="0.03" rgba="0.85 0.15 0.12 1"/>
    </body>
    <body name="green_cube" pos="0.53 -0.1 0.275">
      <geom name="green_cube" type="box" size="0.025 0.025 0.025" euler="0 0 23" rgba="0.2 0.7 0.25 1"/>
    </body>
    <body name="blue_can" pos="0.62 0.13 0.31">
      <geom name="blue_can" type="cylinder" size="0.025 0.06" rgba="0.15 0.35 0.85 1"/>
    </body>
    <body name="yellow_box" pos="0.64 -0.03 0.27">
      <geom name="yellow_box" type="box" size="0.04 0.03 0.02" euler="0 0 -17" rgba="0.95 0.8 0.15 1"/>
    </body>
  </worldbody>
</mujoco>
